# Copy to app/.env.local. Never commit private keys or paid RPC credentials.

# Public browser RPCs. NEXT_PUBLIC_STARKNET_RPC_URL is the Mainnet-compatible
# fallback; the network-specific values take precedence.
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_8
NEXT_PUBLIC_STARKNET_MAINNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_8
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_8

# Portage core contract. Keep 0x0 for mock/demo mode until a verified deployment.
NEXT_PUBLIC_PORTAGE_ADDRESS=0x0
