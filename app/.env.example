# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# (Optional) Your echo/anonymizer helper deployed on Sepolia — enables the Echo
# action there. Leave as 0x0 if not deployed; you can deploy one from the Echo tab
# in the app and paste the returned address here.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0

# (Optional) The Nightfall Fair Game Engine anonymizer contract address. v0 ships
# with 0x0 (not deployed) — Start Game / on-chain actions stay disabled until a
# real address is provided by the contracts worker.
NEXT_PUBLIC_NIGHTFALL_ADDRESS=0x0

# (Optional) The Portage.fun creature/marketplace contract address. Leave as 0x0
# to run the app in demo mode (mock creatures + mock list/buy toggles). Paste a
# deployed contract address here to wire Caravan, Portal and Marketplace to the
# chain. (PORTAGE_ADDRESS is also honored as a non-public fallback.)
NEXT_PUBLIC_PORTAGE_ADDRESS=0x0
