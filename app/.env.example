# Copy to app/.env.local. Never commit private keys or paid RPC credentials.

# Browser RPCs. NEXT_PUBLIC_STARKNET_RPC_URL is the Mainnet-compatible
# fallback; the network-specific values take precedence.
#
# These must be set — there is no working keyless default any more. The old
# `*.public.blastapi.io` endpoints are decommissioned and now answer every
# request with "Blast API is no longer available", and no free public endpoint
# replaced them reliably. One Alchemy key covers both networks: it is the same
# URL with the host swapped between starknet-mainnet and starknet-sepolia.
#
# Anything with NEXT_PUBLIC_ is embedded in the browser bundle verbatim, so a
# keyed RPC URL here is public. Use a key you are willing to have scraped, and
# rate-limit it at the provider.
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY
NEXT_PUBLIC_STARKNET_MAINNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY

# Portage core contract. Keep 0x0 for mock/demo mode until a verified deployment.
NEXT_PUBLIC_PORTAGE_ADDRESS=0x0
