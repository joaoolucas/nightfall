{
  "name": "portage-fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portage.fun — an idle creature-collecting RPG, with publicly verifiable hatches and STRK20 private-payment integration in progress on Starknet.",
  "scripts": {
    "build:app": "npm --prefix app run build",
    "build:contracts": "bash -lc \"cd contracts && scarb build\"",
    "test:contracts": "bash -lc \"cd contracts && scarb test\"",
    "export-abi": "node scripts/export-abi.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify:hatch": "node scripts/verify-hatch.mjs",
    "validate:submission": "node scripts/validate-strk20.mjs",
    "validate:submission:final": "node scripts/validate-strk20.mjs --final --online"
  },
  "dependencies": {
    "starknet": "10.4.0"
  }
}
