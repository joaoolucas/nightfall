# OrcaRouter (OpenAI-compatible) LLM gateway used by the keeper.
# Without a key the keeper falls back to a deterministic mock decision.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_TIMEOUT_MS=15000

# Starknet chain adapter (real Fair Game Engine). Leave NIGHTFALL_CONTRACT_ADDRESS
# empty to run against the in-memory MockChain (zero-config dev path).
NIGHTFALL_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_7
NIGHTFALL_CONTRACT_ADDRESS=

# Which seat this keeper drives.
KEEPER_SEAT=2

# Future per-seat decrypt path: the viewing key used to decrypt THIS seat's
# encrypted role note. Not yet read by the keeper (submitDecision is stubbed).
KEEPER_VIEWING_KEY=
